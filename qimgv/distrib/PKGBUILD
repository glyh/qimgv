# Maintainer: easymodo <easymodofrf@gmail.com>
pkgname=qimgv-git
_pkgname=qimgv
pkgver=v0.43.r13.g27d8602
pkgrel=1
pkgdesc="Simple image viewer written in qt. Supports webm playback."
arch=('i686' 'x86_64')
url="http://github.com/easymodo/qimgv"
license=('GPL3')
depends=('qt6-base' 'qt6-svg' 'qt6-imageformats' 'exiv2' 'hicolor-icon-theme')
makedepends=('git' 'zig' 'qt6-tools' 'mpv' 'opencv')
optdepends=('mpv: webm/video playback through the player_mpv plugin'
			'opencv: higher quality scaling filters')
provides=("qimgv")
conflicts=("qimgv")
source=('git+https://github.com/easymodo/qimgv.git')
md5sums=('SKIP')

pkgver() {
	cd "$_pkgname"
	git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "$_pkgname"
	# build.zig is the build system now; CMake was retired and Qt5 support was dropped.
	# Third-party imageformat plugins are separate projects and not built here.
	zig build \
		-Doptimize=ReleaseFast \
		-Dexiv2=true \
		-Dvideo=true \
		-Dopencv=true
}

package() {
	cd "$_pkgname"
	# The install step lays out bin/, share/applications, share/icons, share/metainfo
	# and share/qimgv/translations, so nothing has to be copied by hand any more.
	zig build install --prefix "$pkgdir/usr" \
		-Doptimize=ReleaseFast \
		-Dexiv2=true \
		-Dvideo=true \
		-Dopencv=true
}
